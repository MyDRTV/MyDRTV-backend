# Kopiér til .env og udfyld. .env committes ikke.

# Lokalt med Postgres.app: 127.0.0.1 og 5433.
# I Docker (docker compose) overskrives de automatisk til db og 5432.
DB_HOST=127.0.0.1
DB_PORT=5433

DB_USERNAME=mydrtv
DB_PASSWORD=skift-mig
DB_DATABASE=mydrtv

# Hvilke frontend-adresser må kalde backenden (kommasepareret).
# Tom = alle må.
CORS_ORIGIN=

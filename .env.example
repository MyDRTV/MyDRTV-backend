# Kopiér til .env og udfyld. .env committes ikke.

# Lokalt gennem SSH-tunnelen til den fælles database: 127.0.0.1 og 5434.
# På serveren sætter docker compose dem selv til db og 5432.
DB_HOST=127.0.0.1
DB_PORT=5434

# App-kontoen, som backenden logger ind med. Den må kun læse og skrive rækker.
DB_USERNAME=mydrtv_app
DB_PASSWORD=password
DB_DATABASE=postgres

# Kun på serveren: superbrugeren (admin-kontoen), som databasen oprettes med.
# Lad dem stå tomme på din Mac.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Hvilke frontend-adresser må kalde backenden (kommasepareret).
# Tom = alle må.
CORS_ORIGIN=
